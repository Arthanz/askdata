# Copy to .env and fill in whichever provider you use.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...        (free tier: aistudio.google.com)

# Provider: auto | anthropic | openai | ollama | gemini
# (auto picks anthropic/openai based on which key is set)
ASKDATA_PROVIDER=auto

# Optional overrides
# ASKDATA_ANTHROPIC_MODEL=claude-sonnet-5
# ASKDATA_OPENAI_MODEL=gpt-4o-mini
# ASKDATA_DB=data/askdata.duckdb
# ASKDATA_MAX_ATTEMPTS=3
# ASKDATA_ROW_LIMIT=500
